# ============================================================
# STEP 12 — DSB/HR GENE-LEVEL EXPRESSION ANALYSIS
#           CONTROL vs LIPID_LOADED
# ============================================================

# ------------------------------------------------------------
# 1. Extract DSB/HR genes
# ------------------------------------------------------------

dsb_genes <- toupper(
  trimws(
    as.character(dsb_gene_universe)
  )
)

dsb_genes <- unique(
  dsb_genes[
    !is.na(dsb_genes) &
    dsb_genes != ""
  ]
)

cat(
  "\nTotal DSB/HR genes:",
  length(dsb_genes),
  "\n"
)


# ------------------------------------------------------------
# 2. Prepare expression matrix
# ------------------------------------------------------------

expr <- as.matrix(
  gse122151_expression_log2
)

storage.mode(expr) <- "numeric"

rownames(expr) <- toupper(
  trimws(
    rownames(expr)
  )
)

expr <- expr[
  !duplicated(rownames(expr)),
  ,
  drop = FALSE
]


# ------------------------------------------------------------
# 3. Identify DSB/HR genes present in GSE122151
# ------------------------------------------------------------

panel_present <- intersect(
  dsb_genes,
  rownames(expr)
)

panel_absent <- setdiff(
  dsb_genes,
  rownames(expr)
)

cat(
  "Genes present in GSE122151:",
  length(panel_present),
  "\n"
)

cat(
  "Genes absent from GSE122151:",
  length(panel_absent),
  "\n"
)


# ------------------------------------------------------------
# 4. Extract DSB/HR expression matrix
# ------------------------------------------------------------

dsb_expression <- expr[
  panel_present,
  ,
  drop = FALSE
]


# ------------------------------------------------------------
# 5. Define experimental groups
# ------------------------------------------------------------

control_samples <- c(
  "HepaRG1_control_S7",
  "HepaRG2_control_S10",
  "HepaRG3_control_S11"
)

lipid_samples <- c(
  "HepaRG5_FA_S12",
  "HepaRG6_FA_S13",
  "HepaRG7_FA_S14"
)


# ------------------------------------------------------------
# 6. Calculate gene-level statistics
# ------------------------------------------------------------

dsb_gene_results <- lapply(
  rownames(dsb_expression),
  function(gene) {
    
    control_values <- as.numeric(
      dsb_expression[
        gene,
        control_samples
      ]
    )
    
    lipid_values <- as.numeric(
      dsb_expression[
        gene,
        lipid_samples
      ]
    )
    
    
    # Group means
    control_mean <- mean(
      control_values,
      na.rm = TRUE
    )
    
    lipid_mean <- mean(
      lipid_values,
      na.rm = TRUE
    )
    
    
    # Group SDs
    control_sd <- sd(
      control_values,
      na.rm = TRUE
    )
    
    lipid_sd <- sd(
      lipid_values,
      na.rm = TRUE
    )
    
    
    # Mean difference:
    # Lipid_Loaded - Control
    mean_difference <- (
      lipid_mean -
      control_mean
    )
    
    
    # --------------------------------------------------------
    # Wilcoxon rank-sum test
    # --------------------------------------------------------
    
    p_value <- wilcox.test(
      control_values,
      lipid_values,
      exact = TRUE
    )$p.value
    
    
    # --------------------------------------------------------
    # Cohen's d
    # --------------------------------------------------------
    
    pooled_sd <- sqrt(
      (
        (length(control_values) - 1) *
          control_sd^2 +
        (length(lipid_values) - 1) *
          lipid_sd^2
      ) /
      (
        length(control_values) +
          length(lipid_values) -
          2
      )
    )
    
    if (
      is.na(pooled_sd) ||
      pooled_sd == 0
    ) {
      cohens_d <- NA_real_
    } else {
      cohens_d <- (
        mean_difference /
        pooled_sd
      )
    }
    
    
    # --------------------------------------------------------
    # Direction of change
    # --------------------------------------------------------
    
    direction <- ifelse(
      mean_difference > 0,
      "Higher in Lipid_Loaded",
      ifelse(
        mean_difference < 0,
        "Lower in Lipid_Loaded",
        "No difference"
      )
    )
    
    
    # --------------------------------------------------------
    # Return results
    # --------------------------------------------------------
    
    data.frame(
      gene = gene,
      
      Control_1 = control_values[1],
      Control_2 = control_values[2],
      Control_3 = control_values[3],
      
      Lipid_Loaded_1 = lipid_values[1],
      Lipid_Loaded_2 = lipid_values[2],
      Lipid_Loaded_3 = lipid_values[3],
      
      Control_mean = control_mean,
      Control_SD = control_sd,
      
      Lipid_Loaded_mean = lipid_mean,
      Lipid_Loaded_SD = lipid_sd,
      
      mean_difference = mean_difference,
      
      Cohens_d = cohens_d,
      
      Wilcoxon_p = p_value,
      
      direction = direction,
      
      stringsAsFactors = FALSE
    )
  }
)


# ------------------------------------------------------------
# 7. Combine results
# ------------------------------------------------------------

gse122151_dsb_gene_results <- do.call(
  rbind,
  dsb_gene_results
)


# ------------------------------------------------------------
# 8. Multiple-testing correction
# ------------------------------------------------------------

gse122151_dsb_gene_results$FDR <- p.adjust(
  gse122151_dsb_gene_results$Wilcoxon_p,
  method = "BH"
)


# ------------------------------------------------------------
# 9. Add replicate consistency
# ------------------------------------------------------------

gse122151_dsb_gene_results$replicate_consistency <- sapply(
  seq_len(nrow(gse122151_dsb_gene_results)),
  function(i) {
    
    difference <- gse122151_dsb_gene_results$mean_difference[i]
    
    lipid_values <- as.numeric(
      gse122151_dsb_gene_results[
        i,
        c(
          "Lipid_Loaded_1",
          "Lipid_Loaded_2",
          "Lipid_Loaded_3"
        )
      ]
    )
    
    control_mean <- gse122151_dsb_gene_results$Control_mean[i]
    
    if (difference > 0) {
      sum(lipid_values > control_mean)
    } else if (difference < 0) {
      sum(lipid_values < control_mean)
    } else {
      NA
    }
  }
)

gse122151_dsb_gene_results$replicate_consistency <- paste0(
  gse122151_dsb_gene_results$replicate_consistency,
  "/3"
)


# ------------------------------------------------------------
# 10. Order by magnitude of expression change
# ------------------------------------------------------------

gse122151_dsb_gene_results <- gse122151_dsb_gene_results[
  order(
    abs(
      gse122151_dsb_gene_results$mean_difference
    ),
    decreasing = TRUE
  ),
]


# ------------------------------------------------------------
# 11. Create absent-gene table
# ------------------------------------------------------------

dsb_absent_results <- data.frame(
  gene = panel_absent,
  stringsAsFactors = FALSE
)


# ------------------------------------------------------------
# 12. Save results
# ------------------------------------------------------------

results_dir <- file.path(
  project_root,
  "results",
  "GSE122151"
)

if (!dir.exists(results_dir)) {
  dir.create(
    results_dir,
    recursive = TRUE
  )
}


write.csv(
  gse122151_dsb_gene_results,
  file.path(
    results_dir,
    "12_GSE122151_DSB_HR_gene_expression_statistics.csv"
  ),
  row.names = FALSE
)

write.csv(
  dsb_absent_results,
  file.path(
    results_dir,
    "12_GSE122151_DSB_HR_genes_absent_from_expression.csv"
  ),
  row.names = FALSE
)

saveRDS(
  gse122151_dsb_gene_results,
  file.path(
    results_dir,
    "12_GSE122151_DSB_HR_gene_expression_statistics.rds"
  )
)


# ------------------------------------------------------------
# 13. Display results
# ------------------------------------------------------------

print(
  gse122151_dsb_gene_results
)

cat(
  "\nStep 12 completed successfully.\n",
  "Total DSB/HR genes:",
  length(dsb_genes),
  "\nGenes analyzed:",
  length(panel_present),
  "\nGenes absent:",
  length(panel_absent),
  "\n"
)
