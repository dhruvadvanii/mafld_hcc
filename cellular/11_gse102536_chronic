collapse_probes_by_median <- function(
    expression_matrix
) {

  gene_ids <-
    rownames(
      expression_matrix
    )

  unique_genes <-
    unique(
      gene_ids
    )

  collapsed <-
    matrix(
      NA_real_,

      nrow =
        length(
          unique_genes
        ),

      ncol =
        ncol(
          expression_matrix
        ),

      dimnames =
        list(
          unique_genes,

          colnames(
            expression_matrix
          )
        )
    )

  for (
    i in seq_along(
      unique_genes
    )
  ) {

    gene <-
      unique_genes[i]

    rows <-
      which(
        gene_ids == gene
      )

    if (
      length(rows) == 1
    ) {

      collapsed[i, ] <-
        expression_matrix[
          rows,
        ]

    } else {

      collapsed[i, ] <-
        apply(

          expression_matrix[
            rows,
            ,
            drop = FALSE
          ],

          2,

          median,

          na.rm = TRUE
        )
    }
  }

  collapsed
}


