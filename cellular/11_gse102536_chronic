if (
  !all(
    gse102536_lipid_ids %in%
      colnames(
        gse102536_gsva_scores
      )
  )
) {

  stop(
    "One or more GSE102536 lipid-treated samples are missing."
  )
}


gse102536_gsva_statistics <-
  lapply(

    rownames(
      gse102536_gsva_scores
    ),

    function(pathway) {

      control_values <-
        as.numeric(

          gse102536_gsva_scores[
            pathway,
            gse102536_control_ids
          ]
        )


      lipid_values <-
        as.numeric(

          gse102536_gsva_scores[
            pathway,
            gse102536_lipid_ids
          ]
        )


      mean_control <-
        mean(
          control_values
        )


      mean_lipid <-
        mean(
          lipid_values
        )


      sd_control <-
        sd(
          control_values
        )


      sd_lipid <-
        sd(
          lipid_values
        )


      pooled_sd <-
        sqrt(

          (

            (
              length(
                control_values
              ) - 1
            ) *

              sd_control^2

            +

            (
              length(
                lipid_values
              ) - 1
            ) *

              sd_lipid^2

          )

          /

          (

            length(
              control_values
            )

            +

            length(
              lipid_values
            )

            - 2

          )
        )


      cohen_d <-
        ifelse(

          pooled_sd > 0,

          (
            mean_lipid -
              mean_control
          ) /

            pooled_sd,

          NA_real_
        )


      wilcox_p <-
        suppressWarnings(

          wilcox.test(

            lipid_values,

            control_values,

            exact = TRUE

          )$p.value
        )


      replicate_consistency <-
        mean(
          lipid_values >
            control_values
        )


      data.frame(

        pathway = pathway,

        Control_1 =
          control_values[1],

        Control_2 =
          control_values[2],

        Control_3 =
          control_values[3],

        Lipid_Loaded_1 =
          lipid_values[1],

        Lipid_Loaded_2 =
          lipid_values[2],

        Lipid_Loaded_3 =
          lipid_values[3],

        Control_mean =
          mean_control,

        Control_SD =
          sd_control,

        Lipid_Loaded_mean =
          mean_lipid,

        Lipid_Loaded_SD =
          sd_lipid,

        mean_difference =
          mean_lipid -
          mean_control,

        Cohen_d =
          cohen_d,

        Wilcoxon_p =
          wilcox_p,

        replicate_consistency =
          replicate_consistency,

        direction =
          ifelse(

            mean_lipid >
              mean_control,

            "Increased",

            ifelse(

              mean_lipid <
                mean_control,

              "Decreased",

              "Unchanged"
            )
          ),

        stringsAsFactors = FALSE
      )
    }
  )


