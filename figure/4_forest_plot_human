# 21. SAVE DATA USED FOR FIGURE
# ============================================================

write.csv(
  forest_dat,
  "Lipid_High_vs_Low_DDR_Forest_Plot_Data.csv",
  row.names = FALSE
)


cat(
  "\n============================================\n",
  "FOREST PLOT COMPLETE\n",
  "============================================\n"
