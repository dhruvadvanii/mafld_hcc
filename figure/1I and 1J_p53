# ============================================================
# 20. FIGURE FUNCTION
# ============================================================

make_p53_figure <- function(
    data,
    score_column,
    plot_title,
    output_prefix,
    tcga_star,
    gse_star
) {

  plot_data <- data[
    !is.na(data[[score_column]]) &
      !is.na(data$Lipid_Group),
  ]

  plot_data$Score <- plot_data[[score_column]]


  # ----------------------------------------------------------
  # Y-axis range
  # ----------------------------------------------------------

  y_min <- min(
    plot_data$Score,
    na.rm = TRUE
  )

  y_max <- max(
    plot_data$Score,
    na.rm = TRUE
  )

  y_range <- y_max - y_min

  if (y_range == 0) {
    y_range <- 1
  }


  # ----------------------------------------------------------
  # Bracket positions
  # ----------------------------------------------------------

  tcga_bar_y <-
    y_max + 0.10 * y_range

  gse_bar_y <-
    y_max + 0.23 * y_range


  # ----------------------------------------------------------
  # Plot
  # ----------------------------------------------------------

  p <- ggplot(
    plot_data,
    aes(
      x = Group,
      y = Score,
      fill = Dataset
    )
  ) +

    geom_boxplot(
      width = 0.62,
      outlier.shape = NA,
      linewidth = 0.55,
      alpha = 0.78
    ) +

    geom_jitter(
      aes(
        color = Dataset
      ),
      width = 0.10,
      size = 1.35,
      alpha = 0.40
    ) +

    scale_fill_manual(
      values = dataset_cols
    ) +

    scale_color_manual(
      values = dataset_cols
    ) +

    scale_x_discrete(
      labels = c(
        "TCGA\nLipid-low",
        "TCGA\nLipid-high",
        "GSE76427\nLipid-low",
        "GSE76427\nLipid-high"
      )
    ) +

    labs(
      title = plot_title,
      x = NULL,
      y = "GSVA enrichment score"
    ) +


    # ========================================================
    # TCGA BRACKET
    # ========================================================

    annotate(
      "segment",
      x = 1,
      xend = 2,
      y = tcga_bar_y,
      yend = tcga_bar_y,
      linewidth = 0.45
    ) +

    annotate(
      "segment",
      x = 1,
      xend = 1,
      y =
        tcga_bar_y -
        0.025 * y_range,
      yend = tcga_bar_y,
      linewidth = 0.45
    ) +

    annotate(
      "segment",
      x = 2,
      xend = 2,
      y =
        tcga_bar_y -
        0.025 * y_range,
      yend = tcga_bar_y,
      linewidth = 0.45
    ) +

    annotate(
      "text",
      x = 1.5,
      y =
        tcga_bar_y +
        0.025 * y_range,
      label = tcga_star,
      size = 4.5,
      fontface = "bold"
    ) +


    # ========================================================
    # GSE76427 BRACKET
    # ========================================================

    annotate(
      "segment",
      x = 3,
      xend = 4,
      y = gse_bar_y,
      yend = gse_bar_y,
      linewidth = 0.45
    ) +

    annotate(
      "segment",
      x = 3,
      xend = 3,
      y =
        gse_bar_y -
        0.025 * y_range,
      yend = gse_bar_y,
      linewidth = 0.45
    ) +

    annotate(
      "segment",
      x = 4,
      xend = 4,
      y =
        gse_bar_y -
        0.025 * y_range,
      yend = gse_bar_y,
      linewidth = 0.45
    ) +

    annotate(
      "text",
      x = 3.5,
      y =
        gse_bar_y +
        0.025 * y_range,
      label = gse_star,
      size = 4.5,
      fontface = "bold"
    ) +


    # ========================================================
    # THEME
    # ========================================================

    theme_classic(
      base_size = 11
    ) +

    theme(
      plot.title = element_text(
        hjust = 0.5,
        face = "bold",
        size = 13
      ),

      axis.title.y = element_text(
        face = "bold",
        size = 10.5
      ),

      axis.text.x = element_text(
        size = 8.5,
        colour = "black",
        lineheight = 0.9
      ),

      axis.text.y = element_text(
        colour = "black",
        size = 9
      ),

      legend.position = "top",

      legend.title = element_blank(),

      legend.text = element_text(
        size = 9
      ),

      axis.line = element_line(
        linewidth = 0.5
      ),

      axis.ticks = element_line(
        linewidth = 0.4
      ),

      plot.margin = margin(
        12,
        12,
        12,
        12
      )
    ) +

    coord_cartesian(
      ylim = c(
        y_min,
        gse_bar_y +
          0.08 * y_range
      ),
      clip = "off"
    )


  # ----------------------------------------------------------
  # PRINT
  # ----------------------------------------------------------

  print(p)


  # ----------------------------------------------------------
  # SAVE PDF
  # ----------------------------------------------------------

  ggsave(
    paste0(
      output_prefix,
      ".pdf"
    ),
    p,
    width = 6.5,
    height = 4.5,
    units = "in",
    device = cairo_pdf
  )


  # ----------------------------------------------------------
  # SAVE PNG
  # ----------------------------------------------------------

  ggsave(
    paste0(
      output_prefix,
      ".png"
    ),
    p,
    width = 6.5,
    height = 4.5,
    units = "in",
    dpi = 600
  )


  return(p)
}


