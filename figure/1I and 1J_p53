# ============================================================
# 7. SIMPLE PATHWAY EXTRACTION FUNCTION
#
# No := or tidy evaluation is used.
# ============================================================

extract_pathway <- function(
    score_matrix,
    pathway_name,
    column_name
) {

  pathway_row <- score_matrix[
    score_matrix$Pathway == pathway_name,
    ,
    drop = FALSE
  ]

  if (nrow(pathway_row) != 1) {

    stop(
      paste0(
        "\nPathway '",
        pathway_name,
        "' was expected once, but ",
        nrow(pathway_row),
        " rows were found."
      )
    )
  }

  result <- data.frame(
    Sample = colnames(score_matrix)[-1],
    Score = as.numeric(
      pathway_row[1, -1]
    ),
    stringsAsFactors = FALSE
  )

  # Ordinary R assignment instead of :=

  colnames(result)[2] <- column_name

  return(result)
}


