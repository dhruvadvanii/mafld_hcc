# ============================================================
# FIGURE 1E — MISMATCH REPAIR (MMR)
# TCGA + GSE76427
# ============================================================

library(ggplot2)
library(dplyr)

# ------------------------------------------------------------
# 1. TCGA DATA
# ------------------------------------------------------------

tcga_mmr <- data.frame(
  Sample = colnames(tcga_pathway_scores),
  MMR = as.numeric(
    tcga_pathway_scores["MISMATCH_REPAIR", ]
  )
)

tcga_mmr$Lipid_Group <- as.character(
  annotation_col[
    match(
      tcga_mmr$Sample,
      rownames(annotation_col)
    ),
    "LipidGroup"
  ]
)

tcga_mmr$Dataset <- "TCGA"


# ------------------------------------------------------------
# 2. GSE76427 DATA
# ------------------------------------------------------------

gse_mmr <- data.frame(
  Sample = colnames(gse_pathway_scores),
  MMR = as.numeric(
    gse_pathway_scores["MISMATCH_REPAIR", ]
  )
)

gse_mmr$Lipid_Group <- as.character(
  gse12_lipid_group
)

gse_mmr$Dataset <- "GSE76427"


# ------------------------------------------------------------
# 3. STANDARDIZE GROUPS
# ------------------------------------------------------------

tcga_mmr$Lipid_Group <- factor(
  tcga_mmr$Lipid_Group,
  levels = c("Lipid-low", "Lipid-high")
)

gse_mmr$Lipid_Group <- factor(
  gse_mmr$Lipid_Group,
  levels = c("Lipid-low", "Lipid-high")
)


# ------------------------------------------------------------
# 4. REMOVE MISSING VALUES
# ------------------------------------------------------------

tcga_mmr <- tcga_mmr[
  !is.na(tcga_mmr$MMR) &
  !is.na(tcga_mmr$Lipid_Group),
]

gse_mmr <- gse_mmr[
  !is.na(gse_mmr$MMR) &
  !is.na(gse_mmr$Lipid_Group),
]


# ------------------------------------------------------------
# 5. COMBINE
# ------------------------------------------------------------

mmr_plot_data <- bind_rows(
  tcga_mmr,
  gse_mmr
)

mmr_plot_data$Dataset <- factor(
  mmr_plot_data$Dataset,
  levels = c("TCGA", "GSE76427")
)


# ------------------------------------------------------------
# 6. DISPLAY GROUPS
# ------------------------------------------------------------

mmr_plot_data$Group <- interaction(
  mmr_plot_data$Dataset,
  mmr_plot_data$Lipid_Group,
  sep = " | ",
  drop = TRUE
)

mmr_plot_data$Group <- factor(
  mmr_plot_data$Group,
  levels = c(
    "TCGA | Lipid-low",
    "TCGA | Lipid-high",
    "GSE76427 | Lipid-low",
    "GSE76427 | Lipid-high"
  )
)


# ------------------------------------------------------------
# 7. COLOURS
# ------------------------------------------------------------

dataset_cols <- c(
  "TCGA" = "#3B6FB6",
  "GSE76427" = "#D8893C"
)


# ------------------------------------------------------------
# 8. Y-AXIS
# ------------------------------------------------------------

y_min <- min(mmr_plot_data$MMR, na.rm = TRUE)
y_max <- max(mmr_plot_data$MMR, na.rm = TRUE)

y_range <- y_max - y_min

if (y_range == 0) {
  y_range <- 1
}


# ------------------------------------------------------------
# 9. CREATE FIGURE
# ------------------------------------------------------------

p_mmr <- ggplot(
  mmr_plot_data,
  aes(
    x = Group,
    y = MMR,
    fill = Dataset
  )
) +

  geom_boxplot(
    width = 0.62,
    outlier.shape = NA,
    linewidth = 0.55,
    alpha = 0.78
  ) +

  geom_jitter(
    aes(color = Dataset),
    width = 0.10,
    size = 1.35,
    alpha = 0.40
  ) +

  scale_fill_manual(
    values = dataset_cols
  ) +

  scale_color_manual(
    values = dataset_cols
  ) +

  scale_x_discrete(
    labels = c(
      "TCGA\nLipid-low",
      "TCGA\nLipid-high",
      "GSE76427\nLipid-low",
      "GSE76427\nLipid-high"
    )
  ) +

  labs(
    title = "Mismatch repair",
    x = NULL,
    y = "GSVA enrichment score"
  ) +

  theme_classic(
    base_size = 11
  ) +

  theme(
    plot.title = element_text(
      hjust = 0.5,
      face = "bold",
      size = 13
    ),

    axis.title.y = element_text(
      face = "bold",
      size = 10.5
    ),

    axis.text.x = element_text(
      size = 8.5,
      colour = "black",
      lineheight = 0.9
    ),

    axis.text.y = element_text(
      colour = "black",
      size = 9
    ),

    legend.position = "top",

    legend.title = element_blank(),

    legend.text = element_text(
      size = 9
    ),

    axis.line = element_line(
      linewidth = 0.5
    ),

    axis.ticks = element_line(
      linewidth = 0.4
    ),

    plot.margin = margin(
      12, 12, 12, 12
    )
  )


# ------------------------------------------------------------
# 10. DISPLAY
# ------------------------------------------------------------

print(p_mmr)


# ------------------------------------------------------------
# 11. SAVE
# ------------------------------------------------------------

ggsave(
  "Figure_1e_MMR_TCGAvsGSE76427.pdf",
  p_mmr,
  width = 6.5,
  height = 4.5,
  units = "in",
  device = cairo_pdf
)

ggsave(
  "Figure_1e_MMR_TCGAvsGSE76427.png",
  p_mmr,
  width = 6.5,
  height = 4.5,
  units = "in",
  dpi = 600
)
