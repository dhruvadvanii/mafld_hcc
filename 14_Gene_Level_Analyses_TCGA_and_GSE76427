# 14.26.10 — MATCH GSE SAMPLES
# ============================================================

expression_samples <-
    colnames(
        gse14_expression_gene_level
    )


lipid_samples <-
    names(
        gse14_lipid_score
    )


common_samples <-
    intersect(
        expression_samples,
        lipid_samples
    )


cat(
    "Expression samples: ",
    length(
        expression_samples
    ),
    "\n",
    sep = ""
)

cat(
    "Lipid-score samples: ",
    length(
        lipid_samples
    ),
    "\n",
    sep = ""
)

cat(
    "Common samples: ",
    length(
        common_samples
    ),
    "\n\n",
    sep = ""
)


if (
    length(
        common_samples
    ) < 10
) {

    # --------------------------------------------------------
    # If lipid score has no useful names but the lengths match,
    # use the existing order.
    # --------------------------------------------------------

    if (
        length(
            gse14_lipid_score
        ) ==
        ncol(
            gse14_expression_gene_level
        )
    ) {

        cat(
            "Sample names could not be matched, but the number ",
            "of lipid-score values equals the number of ",
            "expression samples.\n",
            "Using the established GSE76427 sample order.\n\n",
            sep = ""
        )

        names(
            gse14_lipid_score
        ) <-
            colnames(
                gse14_expression_gene_level
            )

        common_samples <-
            colnames(
                gse14_expression_gene_level
            )

    } else {

