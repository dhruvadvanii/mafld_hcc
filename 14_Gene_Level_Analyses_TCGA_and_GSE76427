  ]


  # --------------------------------------------------------------------
  # CRITICAL FIX:
  # Force the expression matrix to be a TRUE numeric matrix.
  # --------------------------------------------------------------------

  heat_matrix <- as.matrix(
    heat_matrix
  )


  mode(
    heat_matrix
  ) <- "numeric"


  # --------------------------------------------------------------------
  # Remove genes with non-finite values
  # --------------------------------------------------------------------

  finite_gene <- apply(

    heat_matrix,

    1,

    function(x) {

      all(
        is.finite(x)
      )

    }

  )


  heat_matrix <- heat_matrix[
    finite_gene,
    ,
    drop = FALSE
  ]


  # --------------------------------------------------------------------
  # Remove zero-variance genes
  # --------------------------------------------------------------------

  gene_sd <- apply(

    heat_matrix,

    1,

    sd,

    na.rm = TRUE

  )


  variable_genes <- is.finite(
    gene_sd
  ) &
    gene_sd > 0


  heat_matrix <- heat_matrix[
    variable_genes,
    ,
    drop = FALSE
  ]


  cat(
    "Genes remaining after numeric/variance filtering:",
    nrow(heat_matrix),
    "\n\n"
  )


  if (
    nrow(heat_matrix) >= 2 &&
    ncol(heat_matrix) >= 2
  ) {


    # ------------------------------------------------------------------
    # Z-score each gene
    #
    # IMPORTANT:
    # Explicitly use as.numeric matrix before t()
    # ------------------------------------------------------------------

    heat_matrix <- matrix(

      as.numeric(
        heat_matrix
      ),

      nrow = nrow(
        heat_matrix
      ),

      ncol = ncol(
        heat_matrix
      ),

      dimnames = dimnames(
        heat_matrix
      )

    )


    # ------------------------------------------------------------------
    # Scale each gene across samples
    # ------------------------------------------------------------------

    heat_matrix_z <- t(

      apply(

        heat_matrix,

        1,

        function(x) {

          x_mean <- mean(
            x,
            na.rm = TRUE
          )

          x_sd <- sd(
            x,
            na.rm = TRUE
          )


          if (
            !is.finite(x_sd) ||
            x_sd == 0
          ) {

            return(
              rep(
                0,
                length(x)
              )
            )

          }


          (
            x -
              x_mean
          ) /
            x_sd

        }

      )

    )


    # ------------------------------------------------------------------
    # Restore dimensions explicitly
    # ------------------------------------------------------------------

    rownames(
      heat_matrix_z
    ) <- rownames(
      heat_matrix
    )

    colnames(
      heat_matrix_z
    ) <- colnames(
      heat_matrix
    )


