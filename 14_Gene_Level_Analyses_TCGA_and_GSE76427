    sum(
        gse14_results$Significant,
        na.rm = TRUE
    ),
    "\n",
    sep = ""
)

cat(
    "Significant negative genes: ",
    nrow(gse14_negative),
    "\n",
    sep = ""
)

cat(
    "Significant positive genes: ",
    nrow(gse14_positive),
    "\n\n",
    sep = ""
)


cat(
    "Top GSE76427 negative associations:\n\n"
)


if (
    nrow(gse14_negative) > 0
) {

    print(
        head(
            gse14_negative,
            20
        )
    )

} else {

    cat(
        "None at BH-FDR < 0.05.\n"
    )

}


# ======================================================================
# 14.38 — LOAD TCGA RHO VALUES FOR CROSS-COHORT VALIDATION
# ======================================================================

tcga_gene_results <- tcga_step11_results


# ----------------------------------------------------------------------
# Identify TCGA rho column
# ----------------------------------------------------------------------

rho_candidates <- names(
    tcga_gene_results
)[
    grepl(
        "rho|spearman|correlation",
        names(tcga_gene_results),
        ignore.case = TRUE
    )
]


rho_candidates <- rho_candidates[
    !grepl(
        "p|fdr|adjust",
        rho_candidates,
        ignore.case = TRUE
    )
]


if (
    length(rho_candidates) == 0
) {

    stop(
        "\nERROR: Could not identify TCGA rho column.\n"
    )

}


tcga_rho_column <- rho_candidates[1]


# ----------------------------------------------------------------------
# Create clean TCGA table
# ----------------------------------------------------------------------

tcga_clean <- data.frame(

    Gene = toupper(
        trimws(
            as.character(
                tcga_gene_results[
                    ,
                    gene_column
                ]
            )
        )
    ),

    TCGA_rho = suppressWarnings(
        as.numeric(
            tcga_gene_results[
                ,
                tcga_rho_column
            ]
        )
    ),

    stringsAsFactors = FALSE

)


tcga_clean <- tcga_clean[
    tcga_clean$Gene %in%
        expanded_dsb_genes,
    ,
    drop = FALSE
]


tcga_clean <- tcga_clean[
    !duplicated(
        tcga_clean$Gene
    ),
    ,
    drop = FALSE
]


# ======================================================================
# 14.39 — CROSS-COHORT MERGE
# ======================================================================

cross_cohort <- merge(

    tcga_clean,

    gse14_results[
        ,
        c(
            "Gene",
            "N",
            "Spearman_rho",
            "P_value",
            "BH_FDR",
            "Direction",
            "Significant"
        )
    ],

    by = "Gene",

    all = TRUE

)


names(
    cross_cohort
)[
    names(cross_cohort) ==
        "Spearman_rho"
] <- "GSE76427_rho"


names(
    cross_cohort
)[
    names(cross_cohort) ==
        "BH_FDR"
] <- "GSE76427_FDR"


# ======================================================================
# 14.40 — DIRECTIONAL CONCORDANCE
# ======================================================================

cross_cohort$Direction_concordant <- (

    is.finite(
        cross_cohort$TCGA_rho
    ) &

    is.finite(
        cross_cohort$GSE76427_rho
    ) &

    sign(
        cross_cohort$TCGA_rho
    ) ==

    sign(
        cross_cohort$GSE76427_rho
    )

)


cross_cohort$Negative_in_both <- (

    cross_cohort$TCGA_rho < 0 &

    cross_cohort$GSE76427_rho < 0

)


cross_cohort$Significant_in_both <- (

    cross_cohort$TCGA_rho != 0 &

    cross_cohort$GSE76427_rho != 0

)


