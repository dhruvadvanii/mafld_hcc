                    ]

        } else {

            collapsed_matrix[i, ] <-
                apply(
                    gse14_expression[
                        rows_i,
                        ,
                        drop = FALSE
                    ],
                    2,
                    median,
                    na.rm = TRUE
                )

        }

    }


    gse14_expression <- collapsed_matrix

}


# ======================================================================
# 14.30 — MATCH THE SAME GENES USED IN TCGA
# ======================================================================

gse_genes_present <- intersect(
    expanded_dsb_genes,
    rownames(gse14_expression)
)


gse_genes_missing <- setdiff(
    expanded_dsb_genes,
    rownames(gse14_expression)
)


