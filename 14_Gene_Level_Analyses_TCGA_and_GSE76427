# ======================================================================
# 14.18 — LOG TRANSFORM IF RAW COUNTS
# ======================================================================
#
# If the matrix looks like raw RNA-seq counts:
#
#     log2(count + 1)
#
# For Spearman correlations, monotonic transformation does not change
# the rank ordering, so this is mainly for stable visualization and
# downstream expression comparisons.
# ======================================================================

if (
  fraction_integer > 0.80 &&
  max_expression > 100
) {

  cat(
    "TCGA matrix appears to contain raw counts.\n"
  )

  cat(
    "Applying log2(count + 1).\n\n"
  )


  tcga_expr_dsb_analysis <- log2(
    tcga_expr_dsb + 1
  )

} else {

  cat(
    "TCGA matrix does not appear to be raw counts.\n"
  )

  cat(
    "No additional transformation applied.\n\n"
  )


  tcga_expr_dsb_analysis <- tcga_expr_dsb

}


# ======================================================================
# 14.19 — MATCH TCGA SAMPLES TO lipid_score
# ======================================================================

