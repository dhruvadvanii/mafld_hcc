            "not in the Step 14 correlation code.\n"
        )
    )

}


# ======================================================================
# 14.31 — CREATE FINAL GSE GENE MATRIX
# ======================================================================

gse14_gene_expression <- gse14_expression[
    gse_genes_present,
    ,
    drop = FALSE
]


# ======================================================================
# 14.32 — SPEARMAN CORRELATION FOR EVERY GENE
# ======================================================================

cat(
    "\n============================================================\n"
)

cat(
    "14.32 — GSE76427 SPEARMAN CORRELATIONS\n"
)

cat(
    "============================================================\n\n"
)


gse14_results <- data.frame(

    Gene = gse_genes_present,

    N = NA_integer_,

    Spearman_rho = NA_real_,

    P_value = NA_real_,

    stringsAsFactors = FALSE

)


for (
    i in seq_along(gse_genes_present)
) {

    gene_i <- gse_genes_present[i]


    expression_i <- as.numeric(
        gse14_gene_expression[
            gene_i,
            ]
    )


    valid <- is.finite(
        expression_i
    ) &
        is.finite(
            gse14_lipid_score
        )


    n_valid <- sum(
        valid
    )


    gse14_results$N[i] <- n_valid


    if (
        n_valid < 10
    ) {

        next

    }


    if (
        length(
            unique(
                expression_i[valid]
            )
        ) < 2
    ) {

        next

    }


    correlation_test <- suppressWarnings(

        cor.test(

            gse14_lipid_score[valid],

            expression_i[valid],

            method = "spearman",

            exact = FALSE

        )

    )


    gse14_results$Spearman_rho[i] <-
        as.numeric(
            correlation_test$estimate
        )


    gse14_results$P_value[i] <-
        correlation_test$p.value

}


# ======================================================================
# 14.33 — BH-FDR
# ======================================================================

gse14_results$BH_FDR <- p.adjust(
    gse14_results$P_value,
    method = "BH"
)


# ======================================================================
# 14.34 — DIRECTION AND SIGNIFICANCE
# ======================================================================

gse14_results$Direction <- ifelse(

    is.na(
        gse14_results$Spearman_rho
    ),

    "Not tested",

    ifelse(

        gse14_results$Spearman_rho < 0,

        "Negative",

        ifelse(

            gse14_results$Spearman_rho > 0,

            "Positive",

            "Zero"

        )

    )

)


gse14_results$Significant <- (

    !is.na(
        gse14_results$BH_FDR
    ) &

    gse14_results$BH_FDR < 0.05

)


gse14_results <- gse14_results[
    order(
        gse14_results$BH_FDR,
        -abs(
            gse14_results$Spearman_rho
        )
    ),
    ,
    drop = FALSE
]


# ======================================================================
# 14.35 — SAVE COMPLETE GSE RESULTS
# ======================================================================

write.csv(

    gse14_results,

    file.path(
        "results",
        "Step14_GSE76427_DSB_gene_lipid_correlations.csv"
    ),

    row.names = FALSE

)


# ======================================================================
# 14.36 — SIGNIFICANT POSITIVE / NEGATIVE GENES
# ======================================================================

gse14_negative <- gse14_results[
