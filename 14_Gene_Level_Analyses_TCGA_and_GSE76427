read_gmt_genes <- function(
    gmt_file
) {

  lines <- readLines(
    gmt_file,
    warn = FALSE,
    encoding = "UTF-8"
  )

  lines <- lines[
    trimws(lines) != ""
  ]

  if (length(lines) == 0) {

    stop(
      "GMT file is empty: ",
      gmt_file
    )
  }


  genes <- unique(
    unlist(
      strsplit(
        lines,
        "\t",
        fixed = TRUE
      )
    )
  )


  # Remove pathway name + description
  if (length(genes) >= 2) {

    genes <- genes[
      -c(1, 2)
    ]
  }


  genes <- trimws(
    genes
  )

  genes <- genes[
    genes != "" &
      !is.na(genes)
  ]


  # Remove accidental quotes
  genes <- gsub(
    '"',
    "",
    genes
  )

  genes <- gsub(
    "'",
    "",
    genes
  )


  # HGNC symbols
  genes <- toupper(
    genes
  )


  unique(
    genes
  )
}


