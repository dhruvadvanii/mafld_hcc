)


# ============================================================
# 14.26.11 — GENE-LEVEL SPEARMAN CORRELATIONS
# ============================================================

cat(
    "============================================================\n",
    "14.26.11 — GENE–LIPID SPEARMAN CORRELATIONS\n",
    "============================================================\n\n"
)


gse14_results <-
    data.frame(
        Gene =
            tcga14_genes,
        N =
            NA_integer_,
        Spearman_rho =
            NA_real_,
        P_value =
            NA_real_,
        BH_FDR =
            NA_real_,
        Direction =
            NA_character_,
        Significant =
            FALSE,
        stringsAsFactors = FALSE
    )


for (
    i in seq_len(
        nrow(
            gse14_results
        )
    )
) {

    current_gene <-
        gse14_results$Gene[i]


    if (
        !current_gene %in%
        rownames(
            gse14_expression_gene_level
        )
    ) {

        next
    }


    gene_values <-
        as.numeric(
            gse14_expression_gene_level[
                current_gene,
                ]
        )


    lipid_values <-
        as.numeric(
            gse14_lipid_score
        )


    valid <-
        is.finite(
            gene_values
        ) &
        is.finite(
            lipid_values
        )


    n_valid <-
        sum(
            valid
        )


    gse14_results$N[i] <-
        n_valid


    if (
        n_valid < 10
    ) {

        next
    }


    test_result <-
        suppressWarnings(
            cor.test(
                lipid_values[
                    valid
                ],
                gene_values[
                    valid
                ],
                method = "spearman",
                exact = FALSE
            )
        )


    gse14_results$Spearman_rho[i] <-
        as.numeric(
            test_result$estimate
        )


    gse14_results$P_value[i] <-
        test_result$p.value
}


# ============================================================
# 14.26.12 — BENJAMINI-HOCHBERG FDR
# ============================================================

tested <-
    !is.na(
        gse14_results$P_value
    )


if (
    any(
        tested
    )
) {

    gse14_results$BH_FDR[
        tested
    ] <-
        p.adjust(
            gse14_results$P_value[
                tested
            ],
            method = "BH"
        )
}


# ============================================================
# 14.26.13 — DIRECTION AND SIGNIFICANCE
# ============================================================

has_rho <-
    !is.na(
        gse14_results$Spearman_rho
    )


gse14_results$Direction[
    has_rho
] <-
    ifelse(
        gse14_results$Spearman_rho[
            has_rho
        ] < 0,
        "Negative",
        ifelse(
            gse14_results$Spearman_rho[
                has_rho
            ] > 0,
            "Positive",
            "Zero"
        )
    )


gse14_results$Significant <-
    !is.na(
        gse14_results$BH_FDR
    ) &
    gse14_results$BH_FDR < 0.05


gse14_results <-
    gse14_results[
        order(
            gse14_results$Spearman_rho,
            na.last = TRUE
        ),
        ,
        drop = FALSE
    ]


