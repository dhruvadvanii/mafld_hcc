# Put both objects into identical sample order
# ------------------------------------------------------------

gse14_expression_gene_level <-
    gse14_expression_gene_level[
        ,
        common_samples,
        drop = FALSE
    ]


gse14_lipid_score <-
    gse14_lipid_score[
