gse14_lipid_score <-
    as.numeric(
        gse12_lipid_score
    )


# ------------------------------------------------------------
# Obtain lipid-score sample names
# ------------------------------------------------------------

lipid_sample_names <-
    names(
        gse12_lipid_score
    )


if (
    is.null(
        lipid_sample_names
    )
) {

    # If the score has no names, but its length matches the
    # expression matrix, assume the existing expression order
    # is the intended order.

    if (
        length(
            gse14_lipid_score
        ) ==
        ncol(
            gse14_expression_gene_level
        )
    ) {

        lipid_sample_names <-
            colnames(
                gse14_expression_gene_level
            )

        names(
            gse14_lipid_score
        ) <-
            lipid_sample_names

    } else {

        stop(
            paste0(
                "ERROR: gse12_lipid_score has no sample names ",
                "and its length does not match the GSE expression ",
                "matrix."
            )
        )
    }

} else {

    names(
        gse14_lipid_score
    ) <-
        lipid_sample_names
}


