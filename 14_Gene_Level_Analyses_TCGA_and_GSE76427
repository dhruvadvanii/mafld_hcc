# ======================================================================

valid_cross <- cross_cohort[
    is.finite(
        cross_cohort$TCGA_rho
    ) &
    is.finite(
        cross_cohort$GSE76427_rho
    ),
    ,
    drop = FALSE
]


if (
    nrow(valid_cross) >= 3
) {

    cross_test <- suppressWarnings(

        cor.test(

            valid_cross$TCGA_rho,

            valid_cross$GSE76427_rho,

            method = "spearman",

            exact = FALSE

        )

    )


    cross_rho <- as.numeric(
        cross_test$estimate
    )


    cross_p <- cross_test$p.value


} else {

    cross_rho <- NA_real_

    cross_p <- NA_real_

}


