find_gmt <- function(
    filename,
    additional_patterns = NULL
) {

  candidate_paths <- c(

    filename,

    file.path(
      "data",
      filename
    ),

    file.path(
      "data",
      "gmt",
      filename
    ),

    file.path(
      "gmt",
      filename
    ),

    file.path(
      "results",
      filename
    )

  )

  candidate_paths <- candidate_paths[
    file.exists(candidate_paths)
  ]

  if (length(candidate_paths) > 0) {

    return(
      candidate_paths[1]
    )
  }


  # Recursive search
  all_files <- list.files(
    ".",
    recursive = TRUE,
    full.names = TRUE,
    ignore.case = TRUE
  )

  hits <- all_files[
    basename(all_files) == filename
  ]

  if (length(hits) > 0) {

    return(
      hits[1]
    )
  }


  # Pattern search if supplied
  if (!is.null(additional_patterns)) {

    for (pattern in additional_patterns) {

      hits <- all_files[
        grepl(
          pattern,
          basename(all_files),
          ignore.case = TRUE
        )
      ]

      if (length(hits) > 0) {

        return(
          hits[1]
        )
      }
    }
  }


  return(NA_character_)
}


