cat(
  "Running TCGA gene-level Spearman correlations...\n\n"
)


run_gene_spearman <- function(
    expression_matrix,
    score
) {

  results <- lapply(

    seq_len(
      nrow(expression_matrix)
    ),

    function(i) {

      x <- as.numeric(
        expression_matrix[i, ]
      )

      y <- as.numeric(
        score
      )


      keep <- is.finite(x) &
        is.finite(y)


      if (
        sum(keep) < 10
      ) {

        return(
          data.frame(

            gene =
              rownames(
                expression_matrix
              )[i],

            rho = NA_real_,

            p_value = NA_real_,

            n = sum(keep)

          )
        )

      }


      test <- suppressWarnings(

        cor.test(

          x[keep],

          y[keep],

          method = "spearman",

          exact = FALSE

        )

      )


      data.frame(

        gene =
          rownames(
            expression_matrix
          )[i],

        rho =
          unname(
            test$estimate
          ),

        p_value =
          test$p.value,

        n =
          sum(keep)

      )

    }

  )


  results <- bind_rows(
    results
  )


  results$FDR <- p.adjust(

    results$p_value,

    method = "BH"

  )


  results$direction <- ifelse(

    results$rho < 0,

    "Negative",

    "Positive"

  )


  results$significant <- ifelse(

    !is.na(
      results$FDR
    ) &
      results$FDR < 0.05,

    "Yes",

    "No"

  )


  results

}


