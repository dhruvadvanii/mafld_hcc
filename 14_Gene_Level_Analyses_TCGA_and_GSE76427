# ======================================================================
# 14.11 — CONVERT ENSEMBL IDs → HGNC SYMBOLS
# ======================================================================

cat(
  "Converting TCGA Ensembl IDs to HGNC gene symbols...\n\n"
)


tcga_gene_ids <- trimws(
  as.character(
    tcga_gene_ids
  )
)


# Remove Ensembl version suffix
#
# ENSG00000141510.17
# becomes
# ENSG00000141510

tcga_ensembl <- sub(
  "\\.[0-9]+$",
  "",
  tcga_gene_ids
)


# Detect whether IDs are Ensembl
is_ensembl <- grepl(
  "^ENSG[0-9]+$",
  tcga_ensembl,
  ignore.case = TRUE
)


cat(
  "Ensembl IDs detected:",
  sum(is_ensembl),
  "/",
  length(tcga_ensembl),
  "\n\n"
)


if (
  sum(is_ensembl) < 100
) {

  warning(
    "\nFewer than 100 Ensembl IDs detected.\n",
    "The matrix may already use gene symbols.\n"
  )
}


# ----------------------------------------------------------------------
# Annotation using org.Hs.eg.db
# ----------------------------------------------------------------------

annotation_table <- AnnotationDbi::select(

  org.Hs.eg.db,

  keys = unique(
    tcga_ensembl[
      is_ensembl
    ]
  ),

  columns = c(
    "ENSEMBL",
    "SYMBOL"
  ),

  keytype = "ENSEMBL"

)


annotation_table <- annotation_table[
  !is.na(
    annotation_table$SYMBOL
  ) &
    annotation_table$SYMBOL != "",
]


# Keep one symbol per Ensembl ID
annotation_table <- annotation_table[
  !duplicated(
    annotation_table$ENSEMBL
  ),
]


ensembl_to_symbol <- setNames(

  annotation_table$SYMBOL,

  annotation_table$ENSEMBL

)


# ----------------------------------------------------------------------
# Convert
# ----------------------------------------------------------------------

tcga_symbols <- tcga_ensembl


mapped <- is_ensembl &
  tcga_ensembl %in% names(
    ensembl_to_symbol
  )


tcga_symbols[mapped] <- ensembl_to_symbol[
  tcga_ensembl[mapped]
]


# If already symbols, keep them
tcga_symbols <- toupper(
  tcga_symbols
)


tcga_symbols <- trimws(
  tcga_symbols
)


cat(
  "Successfully mapped Ensembl IDs:",
  sum(mapped),
  "\n\n"
)


# ======================================================================
# 14.12 — SET SYMBOLS AS ROW NAMES
# ======================================================================

rownames(tcga_expr) <- tcga_symbols


# ======================================================================
# 14.13 — REMOVE UNMAPPED / INVALID GENES
# ======================================================================

valid_gene_rows <- !is.na(
  rownames(tcga_expr)
) &
  rownames(tcga_expr) != ""


tcga_expr <- tcga_expr[
  valid_gene_rows,
  ,
  drop = FALSE
]


# ======================================================================
# 14.14 — HANDLE DUPLICATE GENE SYMBOLS
# ======================================================================
#
# Multiple Ensembl IDs can map to one HGNC symbol.
#
# We retain the row with the greatest variance across samples.
#
# This avoids arbitrary duplicate removal.
# ======================================================================

if (
  anyDuplicated(
    rownames(tcga_expr)
  ) > 0
) {

  cat(
    "Duplicate HGNC symbols detected.\n"
  )

  cat(
    "Resolving duplicates using highest variance.\n\n"
  )


  gene_variance <- apply(

    tcga_expr,

    1,

    function(x) {

      x <- as.numeric(x)

      var(
        x,
        na.rm = TRUE
      )

    }

  )


  gene_groups <- split(

    seq_len(
      nrow(tcga_expr)
    ),

    rownames(tcga_expr)

  )


  best_rows <- vapply(

    gene_groups,

    function(idx) {

      idx[
        which.max(
          gene_variance[idx]
        )
      ]

    },

    integer(1)

  )


  tcga_expr <- tcga_expr[
    best_rows,
    ,
    drop = FALSE
  ]

}


cat(
  "Unique TCGA genes after mapping:",
  nrow(tcga_expr),
  "\n\n"
)


