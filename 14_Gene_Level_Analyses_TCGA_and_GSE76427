    ) &
    sign(
        concordance_table$TCGA_Spearman_rho
    ) ==
    sign(
        concordance_table$Spearman_rho
    )


concordance_table$Strictly_replicated <-
    concordance_table$TCGA_significant &
    concordance_table$Significant &
    concordance_table$Direction_concordant


concordance_table$Strict_negative_replication <-
    concordance_table$TCGA_significant &
    concordance_table$Significant &
    concordance_table$TCGA_Spearman_rho < 0 &
    concordance_table$Spearman_rho < 0


