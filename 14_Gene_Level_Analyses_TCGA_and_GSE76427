    # ------------------------------------------------------------------
    # Scale each gene across samples
    # ------------------------------------------------------------------

    heat_matrix_z <- t(

      apply(

        heat_matrix,

        1,

        function(x) {

          x_mean <- mean(
            x,
            na.rm = TRUE
          )

          x_sd <- sd(
            x,
            na.rm = TRUE
          )


          if (
            !is.finite(x_sd) ||
            x_sd == 0
          ) {

            return(
              rep(
                0,
                length(x)
              )
            )

          }


          (
            x -
              x_mean
          ) /
            x_sd

        }

      )

    )


