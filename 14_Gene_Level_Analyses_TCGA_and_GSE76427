        gse14_results$BH_FDR
    ) &
    gse14_results$BH_FDR < 0.05 &
    gse14_results$Spearman_rho < 0,
    ,
    drop = FALSE
]


gse14_positive <- gse14_results[
    !is.na(
        gse14_results$BH_FDR
    ) &
    gse14_results$BH_FDR < 0.05 &
    gse14_results$Spearman_rho > 0,
    ,
    drop = FALSE
]


write.csv(

    gse14_negative,

    file.path(
        "results",
        "Step14_GSE76427_significant_negative_DSB_genes.csv"
    ),

    row.names = FALSE

)


write.csv(

