        FDR,
        desc(
          abs(rho)
        )
      )


    write.csv(

      gse_significant,

      file.path(
        results_dir,
        "Step14_GSE76427_significant_DSB_genes.csv"
      ),

      row.names = FALSE

    )


    write.csv(

      gse_negative,

      file.path(
        results_dir,
        "Step14_GSE76427_significant_negative_DSB_genes.csv"
      ),

      row.names = FALSE

    )


    write.csv(

      gse_positive,

      file.path(
        results_dir,
        "Step14_GSE76427_significant_positive_DSB_genes.csv"
      ),

      row.names = FALSE

    )


    cat(
      "GSE76427 genes tested:",
      nrow(gse_gene_results),
      "\n"
    )

    cat(
      "GSE76427 significant:",
      nrow(gse_significant),
      "\n"
    )

    cat(
      "GSE76427 negative:",
      nrow(gse_negative),
      "\n"
    )

    cat(
      "GSE76427 positive:",
      nrow(gse_positive),
      "\n\n"
    )


    # ==================================================================
    # 14.29 — CROSS-COHORT CONCORDANCE
    # ==================================================================

    cat(
      "============================================================\n"
    )

    cat(
      "14.29 — CROSS-COHORT CONCORDANCE\n"
    )

    cat(
      "============================================================\n\n"
    )


    cross_cohort <- inner_join(

      tcga_gene_results %>%

        select(

          gene,

          TCGA_rho = rho,

          TCGA_p = p_value,

          TCGA_FDR = FDR

        ),

      gse_gene_results %>%

        select(

          gene,

          GSE76427_rho = rho,

          GSE76427_p = p_value,

          GSE76427_FDR = FDR

        ),

      by = "gene"

    ) %>%

      left_join(

        gene_membership,

        by = "gene"

      )


    cross_cohort <- cross_cohort %>%

      mutate(

        direction_concordant =

          ifelse(

            sign(
              TCGA_rho
            ) ==

              sign(
                GSE76427_rho
              ),

            "Yes",

            "No"

          ),


        significant_both =

          ifelse(

            TCGA_FDR < 0.05 &

              GSE76427_FDR < 0.05,

            "Yes",

            "No"

          ),


        significant_negative_both =

          ifelse(

            TCGA_FDR < 0.05 &

              GSE76427_FDR < 0.05 &

              TCGA_rho < 0 &

              GSE76427_rho < 0,

            "Yes",

            "No"

          )

      )


    write.csv(

      cross_cohort,

      file.path(
        results_dir,
        "Step14_TCGA_GSE76427_DSB_cross_cohort_concordance.csv"
      ),

      row.names = FALSE

    )


    # ------------------------------------------------------------------
    # Effect-size concordance
    # ------------------------------------------------------------------

    valid_cross <- cross_cohort %>%

      filter(

        is.finite(
          TCGA_rho
        ),

        is.finite(
          GSE76427_rho
        )

      )


    if (
      nrow(valid_cross) >= 3
    ) {

      concordance_test <- cor.test(

        valid_cross$TCGA_rho,

        valid_cross$GSE76427_rho,

        method = "spearman",

        exact = FALSE

      )


      concordance_summary <- data.frame(

        genes_tested =
          nrow(valid_cross),

        spearman_rho =
          unname(
            concordance_test$estimate
          ),

        p_value =
          concordance_test$p.value,

        significant_both =
          sum(
            valid_cross$significant_both ==
              "Yes",
            na.rm = TRUE
          ),

        directionally_concordant =
          sum(
            valid_cross$direction_concordant ==
              "Yes",
            na.rm = TRUE
          ),

        significantly_negative_both =
          sum(
            valid_cross$significant_negative_both ==
              "Yes",
            na.rm = TRUE
          )

      )


      write.csv(

        concordance_summary,

        file.path(
          results_dir,
          "Step14_cross_cohort_concordance_summary.csv"
        ),

        row.names = FALSE

      )


      print(
        concordance_summary
      )

    }


    # ==================================================================
    # 14.30 — FINAL REPRODUCIBLE NEGATIVE GENES
    # ==================================================================

    cat(
      "\n============================================================\n"
    )

    cat(
      "14.30 — FINAL REPRODUCIBLE NEGATIVE GENES\n"
    )

    cat(
      "============================================================\n\n"
    )


    reproducible_negative <- cross_cohort %>%

      filter(

        TCGA_FDR < 0.05,

        GSE76427_FDR < 0.05,

        TCGA_rho < 0,

        GSE76427_rho < 0

      ) %>%

      mutate(

        mean_rho = (

          TCGA_rho +

            GSE76427_rho

        ) / 2,


        minimum_absolute_rho = pmin(

          abs(
            TCGA_rho
          ),

          abs(
            GSE76427_rho
          )

        )

      ) %>%

      arrange(

        desc(
          minimum_absolute_rho
        )

      )


    write.csv(

      reproducible_negative,

      file.path(
        results_dir,
        "Step14_FINAL_reproducible_negative_DSB_genes.csv"
      ),

      row.names = FALSE

    )


    cat(
      "Reproducible negative genes:",
      nrow(reproducible_negative),
      "\n\n"
    )


    if (
      nrow(reproducible_negative) > 0
    ) {

      print(
        reproducible_negative
      )

    }


    # ==================================================================
    # 14.31 — CROSS-COHORT PLOT
    # ==================================================================

    if (
      nrow(valid_cross) >= 3
    ) {

      p_cross <- ggplot(

        valid_cross,

        aes(

          x = TCGA_rho,

          y = GSE76427_rho

        )

      ) +

        geom_point(

          size = 2.5,

          alpha = 0.8

        ) +

        geom_smooth(

          method = "lm",

          se = TRUE

        ) +

        geom_vline(

          xintercept = 0,

          linetype = "dashed"

        ) +

        geom_hline(

          yintercept = 0,

          linetype = "dashed"

        ) +

        theme_classic(

          base_size = 12

        ) +

        labs(

          title =
            "Cross-cohort concordance of DSB-associated genes",

          x =
            "TCGA Spearman ρ",

          y =
            "GSE76427 Spearman ρ"

        )


      ggsave(

        file.path(
          results_dir,
          "Step14_TCGA_GSE76427_DSB_gene_concordance.pdf"
        ),

        p_cross,

        width = 7,

        height = 6

      )

    }


    # ==================================================================
    # 14.32 — FINAL SUMMARY
    # ==================================================================

    final_summary <- data.frame(

      metric = c(

        "Predefined DSB-associated gene universe",

        "TCGA genes tested",

        "TCGA significant genes",

        "TCGA significant negative genes",

        "TCGA significant positive genes",

        "GSE76427 genes tested",

        "GSE76427 significant genes",

        "Genes significant in both cohorts",

        "Directionally concordant genes",

        "Significantly negative in both cohorts"

      ),

      value = c(

        length(
          dsb_gene_universe
        ),

        nrow(
          tcga_gene_results
        ),

        sum(
          tcga_gene_results$FDR < 0.05,
          na.rm = TRUE
        ),

        sum(

          tcga_gene_results$FDR < 0.05 &

            tcga_gene_results$rho < 0,

          na.rm = TRUE

        ),

        sum(

          tcga_gene_results$FDR < 0.05 &

            tcga_gene_results$rho > 0,

          na.rm = TRUE

        ),

        nrow(
          gse_gene_results
        ),

        sum(
          gse_gene_results$FDR < 0.05,
          na.rm = TRUE
        ),

        sum(

          cross_cohort$significant_both ==
            "Yes",

          na.rm = TRUE

        ),

        sum(

          cross_cohort$direction_concordant ==
            "Yes",

          na.rm = TRUE

        ),

        sum(

          cross_cohort$significant_negative_both ==
            "Yes",

          na.rm = TRUE

        )

      )

    )


    write.csv(

      final_summary,

      file.path(
        results_dir,
        "Step14_FINAL_summary.csv"
      ),

      row.names = FALSE

    )


    # ==================================================================
    # 14.33 — DISPLAY FINAL RESULTS
    # ==================================================================

    cat(
      "\n============================================================\n"
    )

    cat(
      "STEP 14 COMPLETE\n"
    )

    cat(
      "============================================================\n\n"
    )


    print(
      final_summary
    )


    cat(
      "\nResults saved to:\n"
    )

    cat(
      normalizePath(
        results_dir,
        winslash = "/"
      ),
      "\n\n"
    )


    cat(
      "Most important final file:\n"
    )

    cat(
      "Step14_FINAL_reproducible_negative_DSB_genes.csv\n\n"
    )


  }

}


