  tcga_expr_dsb_analysis
)

lipid_samples <- names(
  lipid_score
)


common_samples <- intersect(

  expr_samples,

  lipid_samples

)


# ----------------------------------------------------------------------
# If exact matching is poor, use TCGA first-16-character barcodes
# ----------------------------------------------------------------------

if (
  length(common_samples) < 20
) {

  cat(
    "Exact sample matching was insufficient.\n"
  )

  cat(
    "Attempting TCGA barcode matching using first 16 characters.\n\n"
  )


  expr_short <- substr(
    expr_samples,
    1,
    16
  )

  lipid_short <- substr(
    lipid_samples,
    1,
    16
  )


  common_short <- intersect(

    expr_short,

    lipid_short

  )


  if (
    length(common_short) < 20
  ) {

    stop(

      "\nERROR: Unable to adequately match TCGA samples to lipid_score.\n\n",

      "Exact matches: ",
      length(common_samples),
      "\n",

      "Barcode matches: ",
      length(common_short),
      "\n"

    )

  }


  expr_idx <- match(
    common_short,
    expr_short
  )


  lipid_idx <- match(
    common_short,
    lipid_short
  )


  tcga_expr_final <- tcga_expr_dsb_analysis[
    ,
    expr_idx,
    drop = FALSE
  ]


  tcga_lipid_final <- as.numeric(
    lipid_score[
      lipid_idx
    ]
  )


  colnames(
    tcga_expr_final
  ) <- common_short


} else {


  tcga_expr_final <- tcga_expr_dsb_analysis[
    ,
    common_samples,
    drop = FALSE
  ]


  tcga_lipid_final <- as.numeric(
    lipid_score[
      common_samples
    ]
  )

}


cat(
  "Final TCGA matched samples:",
  length(tcga_lipid_final),
  "\n\n"
)


