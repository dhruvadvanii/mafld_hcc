available_pathways <-
    names(
        final_gene_sets
    )


find_pathway_name <-
    function(
        exact_candidates,
        pattern_candidates,
        label
    ) {

        exact_match <-
            exact_candidates[
                exact_candidates %in%
                    available_pathways
            ]


        if (
            length(
                exact_match
            ) > 0
        ) {

            return(
                exact_match[
                    1
                ]
            )

        }


        for (
            current_pattern in
            pattern_candidates
        ) {

            matches <-
                available_pathways[
                    grepl(
                        current_pattern,
                        available_pathways,
                        ignore.case =
                            TRUE
                    )
                ]


            if (
                length(
                    matches
                ) ==
                    1
            ) {

                return(
                    matches[
                        1
                    ]
                )

            }

            if (
                length(
                    matches
                ) >
                    1
            ) {

                stop(
                    paste0(
                        "Multiple pathways matched ",
                        label,
                        ": ",
                        paste(
                            matches,
                            collapse = ", "
                        )
                    )
                )

            }

        }


        stop(
            paste0(
                "Could not identify pathway: ",
                label
            )
        )

    }


