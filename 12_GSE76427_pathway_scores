}


cat(
    "\nSelected expression object: ",
    selected_expression_name,
    "\n",
    sep = ""
)


# ------------------------------------------------------------
# Extract selected object
# ------------------------------------------------------------

if (
    grepl(
        "\\$",
        selected_expression_name
    )
) {

    parent_name <-
        sub(
            "\\$.*$",
            "",
            selected_expression_name
        )


    component_name <-
        sub(
            "^.*\\$",
            "",
            selected_expression_name
        )


    parent_object <-
        get(
            parent_name,
            envir =
                .GlobalEnv
        )


    gse12_expression <-
        getElement(
            parent_object,
            component_name
        )

} else {

    gse12_expression <-
        get(
            selected_expression_name,
            envir =
