) {

    stop(
        "final_gene_sets is missing from the current R session."
    )

}


cat(
    "Confirmed: final_gene_sets exists.\n"
)


# ============================================================
# 12.2 — IDENTIFY THE ACTUAL GSE76427 EXPRESSION MATRIX
# ============================================================

candidate_expression_names <-
    c(
        "gse_symbol_expression",
        "gse_expression",
        "gse_expr",
        "gse76427_gene_expression",
        "gse76427_raw_expression",
        "tumor_expression"
    )


candidate_expression_names <-
    candidate_expression_names[
        candidate_expression_names %in%
            ls(
                envir = .GlobalEnv
            )
    ]


