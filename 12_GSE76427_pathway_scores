# ============================================================
# 12.15 — PRIMARY CORRELATIONS
# ============================================================

gse12_targets <-
    list(
        HR =
            gse12_hr_score,
        DDR =
            gse12_ddr_score,
        NHEJ =
            gse12_nhej_score
    )


gse12_main_correlations <-
    data.frame(
        Pathway =
            names(
                gse12_targets
            ),
        N =
            NA_integer_,
        Spearman_rho =
            NA_real_,
        P_value =
            NA_real_,
        stringsAsFactors =
            FALSE
    )


for (
    i in seq_along(
        gse12_targets
    )
) {

    current_score <-
        getElement(
            gse12_targets,
            i
        )


    valid <-
        is.finite(
            gse12_lipid_score
        ) &
        is.finite(
            current_score
        )


    current_test <-
        suppressWarnings(
            cor.test(
                gse12_lipid_score[
                    valid
                ],
                current_score[
                    valid
                ],
                method =
                    "spearman",
                exact =
                    FALSE
            )
        )


    gse12_main_correlations$N[
        i
    ] <-
        sum(
            valid
        )


    gse12_main_correlations$Spearman_rho[
        i
    ] <-
        as.numeric(
            current_test$estimate
        )


    gse12_main_correlations$P_value[
        i
    ] <-
        current_test$p.value

}


gse12_main_correlations$BH_FDR <-
    p.adjust(
        gse12_main_correlations$P_value,
        method =
