        sum(
            valid
        )


    gse12_component_correlations$Spearman_rho[
        i
    ] <-
        as.numeric(
            current_test$estimate
        )


    gse12_component_correlations$P_value[
        i
    ] <-
        current_test$p.value

}


gse12_component_correlations$BH_FDR <-
    p.adjust(
        gse12_component_correlations$P_value,
        method =
            "BH"
    )


# ============================================================
# 12.17 — LIPID HIGH / LOW
# ============================================================

gse12_lipid_median <-
    median(
        gse12_lipid_score,
        na.rm =
            TRUE
    )


gse12_lipid_group <-
    ifelse(
        gse12_lipid_score >=
            gse12_lipid_median,
        "Lipid-high",
        "Lipid-low"
    )


gse12_lipid_group <-
    factor(
        gse12_lipid_group,
        levels =
            c(
                "Lipid-low",
                "Lipid-high"
            )
    )


# ============================================================
# 12.18 — WILCOXON TESTS
# ============================================================

gse12_wilcox_scores <-
    list(
        HR =
            gse12_hr_score,
        DDR =
            gse12_ddr_score,
        NHEJ =
            gse12_nhej_score
    )


gse12_wilcox_results <-
    data.frame(
        Pathway =
            names(
                gse12_wilcox_scores
            ),
        Lipid_low_median =
            NA_real_,
        Lipid_high_median =
            NA_real_,
        P_value =
            NA_real_,
        stringsAsFactors =
            FALSE
    )


for (
    i in seq_along(
        gse12_wilcox_scores
    )
) {

    current_score <-
        getElement(
            gse12_wilcox_scores,
            i
        )


    low_values <-
        current_score[
            gse12_lipid_group ==
                "Lipid-low"
        ]


    high_values <-
        current_score[
            gse12_lipid_group ==
                "Lipid-high"
        ]


    current_test <-
        wilcox.test(
            low_values,
            high_values,
            exact =
                FALSE
        )


    gse12_wilcox_results$Lipid_low_median[
        i
    ] <-
        median(
            low_values,
            na.rm =
                TRUE
        )


    gse12_wilcox_results$Lipid_high_median[
        i
    ] <-
        median(
            high_values,
            na.rm =
                TRUE
        )


    gse12_wilcox_results$P_value[
        i
    ] <-
        current_test$p.value

}


gse12_wilcox_results$BH_FDR <-
    p.adjust(
        gse12_wilcox_results$P_value,
        method =
            "BH"
    )


