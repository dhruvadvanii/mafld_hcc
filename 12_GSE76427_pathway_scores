# ============================================================
# 12.8 — COLLAPSE DUPLICATE GENES
# ============================================================

if (
    any(
        duplicated(
            rownames(
                gse12_expression
            )
        )
    )
) {

    unique_genes <-
        unique(
            rownames(
                gse12_expression
            )
        )


    collapsed_expression <-
        matrix(
            NA_real_,
            nrow =
                length(
                    unique_genes
                ),
            ncol =
                ncol(
                    gse12_expression
                ),
            dimnames =
                list(
                    unique_genes,
                    colnames(
                        gse12_expression
                    )
                )
        )


    for (
        i in seq_along(
            unique_genes
        )
    ) {

        current_gene <-
            unique_genes[
                i
            ]


        current_rows <-
            which(
                rownames(
                    gse12_expression
                ) ==
                    current_gene
            )


        if (
            length(
                current_rows
            ) ==
                1
        ) {

            collapsed_expression[
                i,
            ] <-
                gse12_expression[
                    current_rows,
                ]

        } else {

            collapsed_expression[
                i,
            ] <-
                apply(
                    gse12_expression[
                        current_rows,
                        ,
                        drop = FALSE
                    ],
                    2,
                    median,
                    na.rm = TRUE
                )

        }

    }


    gse12_expression <-
        collapsed_expression

}


