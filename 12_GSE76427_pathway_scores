    length(
        candidate_expression_names
    ) == 0
) {

    stop(
        "No candidate GSE76427 expression objects were found."
    )

}


cat(
    "\nCandidate expression objects found:\n\n"
)

print(
    candidate_expression_names
)


# ------------------------------------------------------------
# Function to determine whether an object is matrix-like
# ------------------------------------------------------------

is_matrix_like <-
    function(
        object
    ) {

        is.matrix(
            object
        ) ||
        is.data.frame(
            object
        )

    }


# ------------------------------------------------------------
# First search: directly available matrix/data.frame objects
# ------------------------------------------------------------

direct_candidates <-
    character(
        0
    )


for (
    object_name in
    candidate_expression_names
) {

    current_object <-
        get(
            object_name,
            envir =
                .GlobalEnv
        )


    if (
        is_matrix_like(
            current_object
        )
    ) {

        direct_candidates <-
            c(
                direct_candidates,
                object_name
            )

    }

}


cat(
    "\nDirect matrix/data.frame candidates:\n\n"
)

if (
    length(
        direct_candidates
    ) > 0
) {

    print(
        direct_candidates
    )

} else {

    cat(
        "No direct matrix/data.frame candidate found.\n"
    )

}


# ============================================================
# 12.3 — SEARCH INSIDE LIST OBJECTS IF NECESSARY
# ============================================================

if (
    length(
        direct_candidates
    ) == 0
) {

    cat(
        "\nSearching inside list objects for an expression matrix...\n"
    )


    for (
        object_name in
        candidate_expression_names
    ) {

        current_object <-
            get(
                object_name,
                envir =
                    .GlobalEnv
            )


        if (
            is.list(
                current_object
            )
        ) {

            current_names <-
                names(
                    current_object
                )


            if (
                !is.null(
                    current_names
                )
            ) {

                for (
                    component_name in
                    current_names
                ) {

                    component_object <-
                        getElement(
                            current_object,
                            component_name
                        )


                    if (
                        is_matrix_like(
                            component_object
                        )
                    ) {

                        component_rows <-
                            nrow(
                                component_object
                            )


                        component_cols <-
                            ncol(
                                component_object
                            )


                        if (
                            component_cols ==
                                115 &&
                            component_rows >
                                50
                        ) {

                            direct_candidates <-
                                c(
                                    direct_candidates,
                                    paste0(
                                        object_name,
                                        "$",
                                        component_name
                                    )
                                )

                        }

                    }

                }

            }

        }

    }

}


cat(
    "\nExpression matrix candidates compatible with 115 samples:\n\n"
)


if (
    length(
        direct_candidates
    ) > 0
) {

    print(
        direct_candidates
