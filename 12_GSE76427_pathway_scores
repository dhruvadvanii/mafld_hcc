# 12.4 — SELECT THE BEST EXPRESSION MATRIX
# ============================================================
#
# Prefer:
# 1. gse_symbol_expression
# 2. another direct matrix with 115 samples
# 3. matrix stored inside gse76427_gene_expression
#
# ============================================================


preferred_direct <-
    c(
        "gse_symbol_expression",
        "gse_expression",
        "gse_expr",
        "gse76427_raw_expression"
    )


selected_direct <-
    preferred_direct[
        preferred_direct %in%
            direct_candidates
    ]


