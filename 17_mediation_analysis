# ============================================================
# 5. BASIC DATA CLEANING FUNCTION
# ============================================================

prepare_mediation_data <- function(
    pathway_matrix,
    x_variable,
    mediator_variable,
    outcome_variable
) {

  pathway_matrix <- as.matrix(
    pathway_matrix
  )


  required_rows <- c(
    x_variable,
    mediator_variable,
    outcome_variable
  )


  missing_rows <- setdiff(
    required_rows,
    rownames(pathway_matrix)
  )


  if (length(missing_rows) > 0) {

    stop(
      paste0(
        "\nMissing pathway variables:\n",
        paste(
          missing_rows,
          collapse = "\n"
        )
      )
    )
  }


  data <- data.frame(
    sample_id = colnames(pathway_matrix),
    X = as.numeric(
      pathway_matrix[
        x_variable,
        ,
        drop = TRUE
      ]
    ),
    M = as.numeric(
      pathway_matrix[
        mediator_variable,
        ,
        drop = TRUE
      ]
    ),
    Y = as.numeric(
      pathway_matrix[
        outcome_variable,
        ,
        drop = TRUE
      ]
    ),
    stringsAsFactors = FALSE
  )


  data <- data[
    is.finite(data$X) &
    is.finite(data$M) &
    is.finite(data$Y),
    ,
    drop = FALSE
  ]


  if (nrow(data) < 30) {

    stop(
      paste0(
        "\nFewer than 30 complete observations for:\n",
        x_variable,
        " -> ",
        mediator_variable,
        " -> ",
        outcome_variable
      )
    )
  }


  data
}


# ============================================================
# 6. MEDIATION FUNCTION
# ============================================================

run_single_mediation <- function(
    pathway_matrix,
    dataset_name,
    model_name,
    x_variable,
    mediator_variable,
    outcome_variable,
    bootstrap_sims = 5000
) {

  mediation_data <- prepare_mediation_data(
    pathway_matrix = pathway_matrix,
    x_variable = x_variable,
    mediator_variable = mediator_variable,
    outcome_variable = outcome_variable
  )


  # ----------------------------------------------------------
  # Mediator model
  #
  # M = aX + error
  # ----------------------------------------------------------

  mediator_model <- lm(
    M ~ X,
    data = mediation_data
  )


  # ----------------------------------------------------------
  # Outcome model
  #
  # Y = c'X + bM + error
  # ----------------------------------------------------------

  outcome_model <- lm(
    Y ~ X + M,
    data = mediation_data
  )


  # ----------------------------------------------------------
  # Mediation
  # ----------------------------------------------------------

  mediation_fit <- mediation::mediate(
    model.m = mediator_model,
    model.y = outcome_model,
    treat = "X",
    mediator = "M",
    boot = TRUE,
    sims = bootstrap_sims
  )


  # ----------------------------------------------------------
  # Extract estimates
  # ----------------------------------------------------------

  summary_fit <- summary(
    mediation_fit
  )


  result <- tibble(
    dataset = dataset_name,
    model = model_name,
    X = x_variable,
    mediator = mediator_variable,
    outcome = outcome_variable,
    n = nrow(mediation_data),

    total_effect = as.numeric(
      summary_fit$tau.coef
    ),

    total_effect_p = as.numeric(
      summary_fit$tau.p
    ),

    indirect_effect_acme = as.numeric(
      summary_fit$d.avg
    ),

    indirect_effect_ci_low = as.numeric(
      summary_fit$d.avg.ci[1]
    ),

    indirect_effect_ci_high = as.numeric(
      summary_fit$d.avg.ci[2]
    ),

    indirect_effect_p = as.numeric(
      summary_fit$d.avg.p
    ),

    direct_effect_ade = as.numeric(
      summary_fit$z.avg
    ),

    direct_effect_ci_low = as.numeric(
      summary_fit$z.avg.ci[1]
    ),

    direct_effect_ci_high = as.numeric(
      summary_fit$z.avg.ci[2]
    ),

    direct_effect_p = as.numeric(
      summary_fit$z.avg.p
    ),

    proportion_mediated = as.numeric(
      summary_fit$n.avg
    ),

    proportion_mediated_ci_low = as.numeric(
      summary_fit$n.avg.ci[1]
    ),

    proportion_mediated_ci_high = as.numeric(
      summary_fit$n.avg.ci[2]
    ),

    proportion_mediated_p = as.numeric(
      summary_fit$n.avg.p
    )
  )


  # ----------------------------------------------------------
  # Additional regression coefficients
  # ----------------------------------------------------------

  mediator_coefficients <- coef(
    summary(
      mediator_model
    )
  )


  outcome_coefficients <- coef(
    summary(
      outcome_model
    )
  )


  result$a_path_estimate <- as.numeric(
    mediator_coefficients[
      "X",
      "Estimate"
    ]
  )


  result$a_path_p <- as.numeric(
    mediator_coefficients[
      "X",
      "Pr(>|t|)"
    ]
  )


  result$b_path_estimate <- as.numeric(
    outcome_coefficients[
      "M",
      "Estimate"
    ]
  )


  result$b_path_p <- as.numeric(
    outcome_coefficients[
      "M",
      "Pr(>|t|)"
    ]
  )


  result$direct_x_effect_estimate <- as.numeric(
    outcome_coefficients[
      "X",
      "Estimate"
    ]
  )


  result$direct_x_effect_p <- as.numeric(
    outcome_coefficients[
      "X",
      "Pr(>|t|)"
    ]
  )


  result$significant_indirect <- (
    result$indirect_effect_p < 0.05
  )


  result$bootstrap_excludes_zero <- (
    result$indirect_effect_ci_low > 0 |
    result$indirect_effect_ci_high < 0
  )


  list(
    result = result,
    mediation_object = mediation_fit,
    mediator_model = mediator_model,
    outcome_model = outcome_model,
    data = mediation_data
  )
}


