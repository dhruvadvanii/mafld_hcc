# ============================================================
# 8. GENERIC MEDIATION RUNNER
# ============================================================

run_model_set <- function(
    pathway_matrix,
    dataset_name,
    model_name,
    x_variable,
    mediator_variables,
    outcome_variables,
    bootstrap_sims = 5000
) {

  all_results <- list()

  all_objects <- list()

  counter <- 1


  for (mediator_variable in mediator_variables) {

    for (outcome_variable in outcome_variables) {

      cat(
        "\nRunning:",
        dataset_name,
        "|",
        model_name,
        "|",
        x_variable,
        "->",
        mediator_variable,
        "->",
        outcome_variable,
        "\n"
      )


      required_rows <- c(
        x_variable,
        mediator_variable,
        outcome_variable
      )


      missing_rows <- setdiff(
        required_rows,
        rownames(pathway_matrix)
      )


      if (length(missing_rows) > 0) {

        cat(
          "  SKIPPED: missing pathway(s): ",
          paste(
            missing_rows,
            collapse = ", "
          ),
          "\n",
          sep = ""
        )

        next
      }


      mediation_run <- tryCatch(

        run_single_mediation(
          pathway_matrix = pathway_matrix,
          dataset_name = dataset_name,
          model_name = model_name,
          x_variable = x_variable,
          mediator_variable = mediator_variable,
          outcome_variable = outcome_variable,
          bootstrap_sims = bootstrap_sims
        ),

        error = function(e) {

          cat(
            "  ERROR: ",
            conditionMessage(e),
            "\n",
            sep = ""
          )

          NULL
        }
      )


      if (!is.null(mediation_run)) {

        all_results[[counter]] <- mediation_run$result

        object_name <- paste(
          dataset_name,
          model_name,
          mediator_variable,
          outcome_variable,
          sep = "_"
        )

        object_name <- gsub(
          "[^A-Za-z0-9_]",
          "_",
          object_name
        )


        all_objects[
          object_name
        ] <- list(
          mediation_run
        )


        counter <- counter + 1
      }
    }
  }


  if (length(all_results) == 0) {

    return(
      list(
        results = tibble(),
        objects = list()
      )
    )
  }


  combined_results <- bind_rows(
    all_results
  )


  list(
    results = combined_results,
    objects = all_objects
  )
}


