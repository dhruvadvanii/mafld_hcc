# ------------------------------------------------------------
# 14B.9 — COUNT PROBES PER CANDIDATE GENE
# ------------------------------------------------------------

count_candidate_probes <- function(
    probe_map,
    candidate_genes
) {

    output <- data.frame(
        gene = candidate_genes,
        probe_count = 0L,
        stringsAsFactors = FALSE
    )


    for (i in seq_along(candidate_genes)) {

        current_gene <- candidate_genes[i]

        output$probe_count[i] <- sum(
            probe_map$gene_symbol ==
                current_gene,
            na.rm = TRUE
        )
    }


    output
}


gpl571_candidate_probe_counts <- count_candidate_probes(
    gpl571_candidate_probe_map,
    gse14520_candidate_genes
)

gpl3921_candidate_probe_counts <- count_candidate_probes(
    gpl3921_candidate_probe_map,
    gse14520_candidate_genes
)


