# ------------------------------------------------------------
# 14A.9 — CONVERT TISSUE ANNOTATION TO TUMOR/NON-TUMOR
# ------------------------------------------------------------

classify_tissue <- function(
    x
) {

    x <- as.character(
        x
    )

    result <- rep(
        NA_character_,
        length(x)
    )


    result[
        grepl(
            "Liver Tumor Tissue",
            x,
            ignore.case = TRUE
        )
    ] <- "HCC_TUMOR"


    result[
        grepl(
            "Liver Non-Tumor Tissue",
            x,
            ignore.case = TRUE
        )
    ] <- "NON_TUMOR"


    result[
        grepl(
            "healthy",
            x,
            ignore.case = TRUE
        )
    ] <- "HEALTHY_LIVER"


    result
}


