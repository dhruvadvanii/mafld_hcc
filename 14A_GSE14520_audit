# ------------------------------------------------------------
# 14A.6 — FUNCTION TO EXTRACT GEO SAMPLE FIELD
# ------------------------------------------------------------

extract_geo_field <- function(
    file_path,
    field_name
) {

    con <- file(
        file_path,
        open = "rt"
    )

    lines <- readLines(
        con,
        warn = FALSE
    )

    close(con)


    target <- grep(
        paste0(
            "^!",
            field_name,
            "\t"
        ),
        lines,
        ignore.case = TRUE
    )


    if (length(target) == 0) {

        return(
            character(0)
        )
    }


    line_text <- lines[
        target[1]
    ]


    field_df <- read.delim(
        text = line_text,
        header = FALSE,
        sep = "\t",
        quote = "\"",
        comment.char = "",
        check.names = FALSE,
        stringsAsFactors = FALSE
    )


    if (ncol(field_df) < 2) {

        return(
            character(0)
        )
    }


    values <- as.character(
        field_df[
            1,
            2:ncol(field_df)
        ]
    )


    values <- trimws(
        values
    )


    return(
        values
    )
}


