extract_tissue_characteristics <- function(
    file_path
) {

    con <- file(
        file_path,
        open = "rt"
    )

    lines <- readLines(
        con,
        warn = FALSE
    )

    close(con)


    characteristic_lines <- grep(
        "^!Sample_characteristics_ch1",
        lines,
        ignore.case = TRUE
    )


    if (length(characteristic_lines) == 0) {

        return(
            character(0)
        )
    }


    output <- character(0)


    for (line_number in characteristic_lines) {

        line_text <- lines[
            line_number
        ]


        field_df <- read.delim(
            text = line_text,
            header = FALSE,
            sep = "\t",
            quote = "\"",
            comment.char = "",
            check.names = FALSE,
            stringsAsFactors = FALSE
        )


        if (ncol(field_df) < 2) {
            next
        }


        values <- as.character(
            field_df[
                1,
                2:ncol(field_df)
            ]
        )


        tissue_values <- values[
            grepl(
                "Tissue:",
                values,
                ignore.case = TRUE
            )
        ]


        if (length(tissue_values) > 0) {

            output <- c(
                output,
                tissue_values
            )
        }
    }


    return(
        output
    )
}


