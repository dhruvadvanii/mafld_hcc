# ------------------------------------------------------------
# 14A.2 — READ GEO SERIES MATRIX
# ------------------------------------------------------------
#
# IMPORTANT:
# These files use:
#
#   !series_matrix_table_begin
#
# followed by:
#
#   "ID_REF"  "GSM..."
#
# Therefore we specifically use this marker.
#
# ------------------------------------------------------------

read_gse14520_matrix <- function(
    file_path
) {

    cat(
        "\nReading:",
        basename(file_path),
        "\n"
    )


    con <- file(
        file_path,
        open = "rt"
    )

    lines <- readLines(
        con,
        warn = FALSE
    )

    close(con)


    # --------------------------------------------------------
    # Locate expression table
    # --------------------------------------------------------

    table_begin <- grep(
        "^!series_matrix_table_begin",
        lines,
        ignore.case = TRUE
    )

    table_end <- grep(
        "^!series_matrix_table_end",
        lines,
        ignore.case = TRUE
    )


    if (length(table_begin) == 0) {

        stop(
            paste0(
                "\nERROR: !series_matrix_table_begin not found in:\n",
                basename(file_path),
                "\n"
            )
        )
    }


    header_line <- table_begin[1] + 1


    if (length(table_end) > 0) {

        end_line <- table_end[1] - 1

    } else {

        end_line <- length(lines)
    }


    # --------------------------------------------------------
    # Extract expression table
    # --------------------------------------------------------

    expression_lines <- lines[
        header_line:end_line
    ]

    expression_lines <- expression_lines[
        !grepl(
            "^!",
            expression_lines
        )
    ]

    expression_lines <- expression_lines[
        nzchar(
            trimws(
                expression_lines
            )
        )
    ]


    # --------------------------------------------------------
    # Read expression table
    # --------------------------------------------------------

    expression_df <- read.delim(
        text = expression_lines,
        header = TRUE,
        sep = "\t",
        quote = "\"",
        comment.char = "",
        check.names = FALSE,
        stringsAsFactors = FALSE,
        fill = TRUE
    )


    if (ncol(expression_df) < 2) {

        stop(
            paste0(
                "\nERROR: Expression matrix has fewer than 2 columns in:\n",
                basename(file_path),
                "\n"
            )
        )
    }


    # --------------------------------------------------------
    # First column = probe ID
    # --------------------------------------------------------

    probe_ids <- as.character(
        expression_df[, 1]
    )


    # --------------------------------------------------------
    # Remaining columns = samples
    # --------------------------------------------------------

    expression_values <- expression_df[
        ,
        -1,
        drop = FALSE
    ]


    expression_matrix <- as.matrix(
        expression_values
    )

    suppressWarnings(
        storage.mode(
            expression_matrix
        ) <- "numeric"
    )


    rownames(
        expression_matrix
    ) <- probe_ids


    # --------------------------------------------------------
    # Remove invalid probe rows
    # --------------------------------------------------------

    keep_rows <- !is.na(
        rownames(
            expression_matrix
        )
    ) &
    nzchar(
        trimws(
            rownames(
                expression_matrix
            )
        )
    )


    expression_matrix <- expression_matrix[
        keep_rows,
        ,
        drop = FALSE
    ]


    return(
        expression_matrix
    )
}


