audit_expression_scale <- function(
    expression_matrix,
    platform
) {

    values <- as.numeric(
        expression_matrix
    )

    values <- values[
        is.finite(values)
    ]


    result <- data.frame(
        platform = platform,
        n_values = length(values),
        minimum = min(
            values,
            na.rm = TRUE
        ),
        median = median(
            values,
            na.rm = TRUE
        ),
        maximum = max(
            values,
            na.rm = TRUE
        ),
        missing_values = sum(
            !is.finite(
                as.numeric(
                    expression_matrix
                )
            )
        ),
        stringsAsFactors = FALSE
    )


    result
}


