# ============================================================
# 6. PREPARE MEDIATION DATA
# ============================================================

prepare_mediation_data <- function(
    pathway_matrix,
    x_variable,
    mediator_variable,
    outcome_variable
) {

  pathway_matrix <- as.matrix(
    pathway_matrix
  )


  required_rows <- c(
    x_variable,
    mediator_variable,
    outcome_variable
  )


  missing_rows <- setdiff(
    required_rows,
    rownames(pathway_matrix)
  )


  if (length(missing_rows) > 0) {

    stop(
      paste0(
        "\nMissing pathway variables:\n",
        paste(
          missing_rows,
          collapse = "\n"
        )
      )
    )
  }


  data <- data.frame(
    sample_id = colnames(pathway_matrix),

    X = as.numeric(
      pathway_matrix[
        x_variable,
        ,
        drop = TRUE
      ]
    ),

    M = as.numeric(
      pathway_matrix[
        mediator_variable,
        ,
        drop = TRUE
      ]
    ),

    Y = as.numeric(
      pathway_matrix[
        outcome_variable,
        ,
        drop = TRUE
      ]
    ),

    stringsAsFactors = FALSE
  )


  # ----------------------------------------------------------
  # Remove incomplete / non-finite observations
  # ----------------------------------------------------------

  data <- data[
    is.finite(data$X) &
      is.finite(data$M) &
      is.finite(data$Y),
    ,
    drop = FALSE
  ]


  # ----------------------------------------------------------
  # Minimum sample size
  # ----------------------------------------------------------

  if (nrow(data) < 30) {

    stop(
      paste0(
        "\nFewer than 30 complete observations for:\n",
        x_variable,
        " -> ",
        mediator_variable,
        " -> ",
        outcome_variable,
        "\nComplete observations: ",
        nrow(data)
      )
    )
  }


  return(data)
}


# ============================================================
# 7. RUN ONE MEDIATION ANALYSIS
# ============================================================

run_single_mediation <- function(
    pathway_matrix,
    dataset_name,
    x_variable,
    mediator_variable,
    outcome_variable,
    bootstrap_sims = 5000
) {


  # ----------------------------------------------------------
  # Prepare data
  # ----------------------------------------------------------

  mediation_data <- prepare_mediation_data(
    pathway_matrix = pathway_matrix,
    x_variable = x_variable,
    mediator_variable = mediator_variable,
    outcome_variable = outcome_variable
  )


  # ----------------------------------------------------------
  # Mediator model
  #
  # M = aX + error
  # ----------------------------------------------------------

  mediator_model <- lm(
    M ~ X,
    data = mediation_data
  )


  # ----------------------------------------------------------
  # Outcome model
  #
  # Y = c'X + bM + error
  # ----------------------------------------------------------

  outcome_model <- lm(
    Y ~ X + M,
    data = mediation_data
  )


  # ----------------------------------------------------------
  # Bootstrap mediation
  # ----------------------------------------------------------

  mediation_fit <- mediation::mediate(
    model.m = mediator_model,
    model.y = outcome_model,
    treat = "X",
    mediator = "M",
    boot = TRUE,
    sims = bootstrap_sims
  )


  # ----------------------------------------------------------
  # Extract mediation summary
  # ----------------------------------------------------------

  summary_fit <- summary(
    mediation_fit
  )


  # ----------------------------------------------------------
  # Extract regression coefficients
  # ----------------------------------------------------------

  mediator_coefficients <- coef(
    summary(
      mediator_model
    )
  )


  outcome_coefficients <- coef(
    summary(
      outcome_model
    )
  )


  # ----------------------------------------------------------
  # Construct result
  # ----------------------------------------------------------

  result <- tibble(

    dataset = dataset_name,

    X = x_variable,

    mediator = mediator_variable,

    outcome = outcome_variable,

    n = nrow(mediation_data),


    # --------------------------------------------------------
    # Total effect
    # --------------------------------------------------------

    total_effect = as.numeric(
      summary_fit$tau.coef
    ),

    total_effect_p = as.numeric(
      summary_fit$tau.p
    ),


    # --------------------------------------------------------
    # Indirect / mediated effect
    # --------------------------------------------------------

    indirect_effect_acme = as.numeric(
      summary_fit$d.avg
    ),

    indirect_effect_ci_low = as.numeric(
      summary_fit$d.avg.ci[1]
    ),

    indirect_effect_ci_high = as.numeric(
      summary_fit$d.avg.ci[2]
    ),

    indirect_effect_p = as.numeric(
      summary_fit$d.avg.p
    ),


    # --------------------------------------------------------
    # Direct effect
    # --------------------------------------------------------

    direct_effect_ade = as.numeric(
      summary_fit$z.avg
    ),

    direct_effect_ci_low = as.numeric(
      summary_fit$z.avg.ci[1]
    ),

    direct_effect_ci_high = as.numeric(
      summary_fit$z.avg.ci[2]
    ),

    direct_effect_p = as.numeric(
      summary_fit$z.avg.p
    ),


    # --------------------------------------------------------
    # Proportion mediated
    # --------------------------------------------------------

    proportion_mediated = as.numeric(
      summary_fit$n.avg
    ),

    proportion_mediated_ci_low = as.numeric(
      summary_fit$n.avg.ci[1]
    ),

    proportion_mediated_ci_high = as.numeric(
      summary_fit$n.avg.ci[2]
    ),

    proportion_mediated_p = as.numeric(
      summary_fit$n.avg.p
    ),


    # --------------------------------------------------------
    # a path
    #
    # X -> M
    # --------------------------------------------------------

    a_path_estimate = as.numeric(
      mediator_coefficients[
        "X",
        "Estimate"
      ]
    ),

    a_path_p = as.numeric(
      mediator_coefficients[
        "X",
        "Pr(>|t|)"
      ]
    ),


    # --------------------------------------------------------
    # b path
    #
    # M -> Y controlling for X
    # --------------------------------------------------------

    b_path_estimate = as.numeric(
      outcome_coefficients[
        "M",
        "Estimate"
      ]
    ),

    b_path_p = as.numeric(
      outcome_coefficients[
        "M",
        "Pr(>|t|)"
      ]
    ),


    # --------------------------------------------------------
    # Direct X effect
    #
    # X -> Y controlling for M
    # --------------------------------------------------------

    direct_x_effect_estimate = as.numeric(
      outcome_coefficients[
        "X",
        "Estimate"
      ]
    ),

    direct_x_effect_p = as.numeric(
      outcome_coefficients[
        "X",
        "Pr(>|t|)"
      ]
    )
  )


  # ----------------------------------------------------------
  # Bootstrap criterion
  # ----------------------------------------------------------

  result$bootstrap_excludes_zero <- (
    result$indirect_effect_ci_low > 0 |
      result$indirect_effect_ci_high < 0
  )


  # ----------------------------------------------------------
  # Unadjusted significance criterion
  # ----------------------------------------------------------

  result$significant_indirect <- (
    result$indirect_effect_p < 0.05
  )


  # ----------------------------------------------------------
  # Return everything
  # ----------------------------------------------------------

  return(
    list(
      result = result,
      mediation_object = mediation_fit,
      mediator_model = mediator_model,
      outcome_model = outcome_model,
      data = mediation_data
    )
  )
}


# ============================================================
# 8. RUN MODEL SET
# ============================================================

run_model_set <- function(
    pathway_matrix,
    dataset_name,
    x_variable,
    mediator_variable,
    outcome_variables,
    bootstrap_sims = 5000
) {

  all_results <- list()

  all_objects <- list()

  counter <- 1


  for (outcome_variable in outcome_variables) {


    cat(
      "\n--------------------------------------------\n"
    )


    cat(
      "Running mediation:\n",
      dataset_name,
      " | ",
      x_variable,
      " -> ",
      mediator_variable,
      " -> ",
      outcome_variable,
      "\n",
      sep = ""
    )


    # --------------------------------------------------------
    # Check pathways
    # --------------------------------------------------------

    required_rows <- c(
      x_variable,
      mediator_variable,
      outcome_variable
    )


    missing_rows <- setdiff(
      required_rows,
      rownames(
        as.matrix(pathway_matrix)
      )
    )


    if (length(missing_rows) > 0) {

      cat(
        "SKIPPED: missing pathway(s): ",
        paste(
          missing_rows,
          collapse = ", "
        ),
        "\n",
        sep = ""
      )


      next
    }


    # --------------------------------------------------------
    # Run mediation safely
    # --------------------------------------------------------

    mediation_run <- tryCatch(

      run_single_mediation(
        pathway_matrix = pathway_matrix,
        dataset_name = dataset_name,
        x_variable = x_variable,
        mediator_variable = mediator_variable,
        outcome_variable = outcome_variable,
        bootstrap_sims = bootstrap_sims
      ),

      error = function(e) {

        cat(
          "ERROR: ",
          conditionMessage(e),
          "\n",
          sep = ""
        )

        return(NULL)
      }
    )


    # --------------------------------------------------------
    # Store successful analysis
    # --------------------------------------------------------

    if (!is.null(mediation_run)) {

      all_results[[counter]] <- (
        mediation_run$result
      )


      object_name <- paste(
        dataset_name,
        "G2M",
        outcome_variable,
        sep = "_"
      )


      object_name <- gsub(
        "[^A-Za-z0-9_]",
        "_",
        object_name
      )


      all_objects[
        object_name
      ] <- list(
        mediation_run
      )


      counter <- counter + 1
    }
  }


  # ----------------------------------------------------------
  # Return empty object if no analyses completed
  # ----------------------------------------------------------

  if (length(all_results) == 0) {

    return(
      list(
        results = tibble(),
        objects = list()
      )
    )
  }


  # ----------------------------------------------------------
  # Combine results
  # ----------------------------------------------------------

  combined_results <- bind_rows(
    all_results
  )


  return(
    list(
      results = combined_results,
      objects = all_objects
    )
  )
}


