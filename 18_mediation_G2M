# ============================================================
# 5. CHECK REQUIRED PATHWAYS
# ============================================================

check_pathways <- function(
    pathway_matrix,
    dataset_name,
    x_variable,
    mediator_variable,
    outcome_variables
) {

  pathway_matrix <- as.matrix(
    pathway_matrix
  )


  required_rows <- c(
    x_variable,
    mediator_variable,
    outcome_variables
  )


  missing_rows <- setdiff(
    required_rows,
    rownames(pathway_matrix)
  )


  if (length(missing_rows) > 0) {

    stop(
      paste0(
        "\nMissing pathway variables in ",
        dataset_name,
        ":\n",
        paste(
          missing_rows,
          collapse = "\n"
        ),
        "\n"
      )
    )
  }


  cat(
    "\nPathway check passed for ",
    dataset_name,
    "\n",
    sep = ""
  )


  cat(
    "X: ",
    x_variable,
    "\n",
    sep = ""
  )


  cat(
    "M: ",
    mediator_variable,
    "\n",
    sep = ""
  )


  cat(
    "Y pathways:\n",
    paste(
      outcome_variables,
      collapse = "\n"
    ),
    "\n"
  )
}


