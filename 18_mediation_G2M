    g2m_mediation_results$indirect_effect_fdr < 0.05
  )


  g2m_mediation_results$bootstrap_and_fdr_supported <- (

    g2m_mediation_results$bootstrap_excludes_zero &

      g2m_mediation_results$significant_indirect_fdr

  )
}


